# WineskinCX 23.7.1 revision 4 (CrossOver 23 / wine 8.0.1), as shipped by Wineskin
# Winery, plus the dylibs from the Wineskin 3.0.6_3 wrapper template, which the
# engine needs at run time. Neither has a stable download URL, so both are taken
# from the local Wineskin folders and pinned: the archive by SHA256, the
# frameworks folder by core/tree-sha.sh. Unpacking needs 7-Zip (brew install sevenzip).
# The default engine: on Alpha Centauri it idles at ~10% CPU with clean sound,
# where wowsilicon-r17 spun a full core and crackled (docs/INTERNALS.md).
ENGINE_KIND=wineskin
ENGINE_URL="file://${HOME}/Library/Application Support/Wineskin/Engines/WS12WineCX64Bit23.7.1-4.tar.7z"
ENGINE_SHA256=ae2564351c6e5eec880bab64ce59c3990469b9ae0e77fd6c03aac0472db39227
ENGINE_FRAMEWORKS="${HOME}/Library/Application Support/Wineskin/Wrapper/Wineskin-3.0.6_3.app/Contents/Frameworks"
ENGINE_FRAMEWORKS_SHA256=1194c7cf0ce951c34322330a575c6e0e6e67904f90a1141dc9f1699528e4d6fc
ENGINE_LOADER=bin/wine64
